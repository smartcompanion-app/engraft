{
  "name": "engraft-monorepo",
  "private": true,
  "description": "Monorepo for engraft: the CLI published to npm, and its documentation site.",
  "license": "BSD-2-Clause",
  "author": "SmartCompanion Team <hello@smartcompanion.app> (https://smartcompanion.app)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smartcompanion-app/engraft.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w packages/engraft",
    "test": "npm run test -w packages/engraft",
    "test:unit": "npm run test:unit -w packages/engraft",
    "test:e2e": "npm run test:e2e -w packages/engraft",
    "typecheck": "npm run typecheck -w packages/engraft -w packages/docs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check:publish": "npm run check:publish -w packages/engraft",
    "docs:start": "npm run start -w packages/docs",
    "docs:build": "npm run build -w packages/docs",
    "changeset": "changeset",
    "version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
